@model WearDrop.Web.Models.Kategori
@{
    ViewData["Title"] = "Edit Kategori";
    ViewData["PageTitle"] = $"Edit Kategori #{Model.IdKategori}";
}

<div class="max-w-xl bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm">
    <form asp-action="Edit" asp-route-id="@Model.IdKategori" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div>
            <label asp-for="NamaKategori" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <input asp-for="NamaKategori"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm focus:outline-none focus:border-slate" />
            <span asp-validation-for="NamaKategori"></span>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t border-stone-100">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-xs font-bold text-stone-700">Batal</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">Perbarui Kategori</button>
        </div>
    </form>
</div>
