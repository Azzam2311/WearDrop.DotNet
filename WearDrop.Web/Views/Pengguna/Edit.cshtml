@model WearDrop.Web.Models.AdminUser
@{
    ViewData["Title"] = "Edit Pengguna";
    ViewData["PageTitle"] = $"Edit Akun Staf #{Model.IdAdmin}";
}

<div class="max-w-xl bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm">
    <form asp-action="Edit" asp-route-id="@Model.IdAdmin" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Nama" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <input asp-for="Nama"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
            <span asp-validation-for="Nama"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <input asp-for="Email" type="email"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
            <span asp-validation-for="Email"></span>
        </div>

        <div>
            <label asp-for="Role" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <select asp-for="Role" class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                <option value="admin">Admin</option>
                <option value="kasir">Kasir</option>
                <option value="karyawan">Karyawan</option>
            </select>
            <span asp-validation-for="Role"></span>
        </div>

        <div>
            <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Password Baru (Opsional)</label>
            <input type="password" name="newPassword" minlength="8" placeholder="Kosongkan jika tidak ingin mengubah password"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
            @Html.ValidationMessage("newPassword", null, new { @class = "field-validation-error" })
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t border-stone-100">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-xs font-bold text-stone-700">Batal</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">Perbarui Pengguna</button>
        </div>
    </form>
</div>
