@{
    ViewData["Title"] = "Buat Transaksi";
    ViewData["PageTitle"] = "Input Transaksi Baru (POS)";
    var pelanggans = ViewBag.Pelanggans as List<WearDrop.Web.Models.Pelanggan> ?? new();
    var produks = ViewBag.Produks as List<WearDrop.Web.Models.Produk> ?? new();
    var promos = ViewBag.Promos as List<WearDrop.Web.Models.Promo> ?? new();
}

<div class="max-w-2xl bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm">
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Pilih Pelanggan</label>
            <select name="idPelanggan" required class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                <option value="">-- Pilih Pelanggan --</option>
                @foreach (var c in pelanggans)
                {
                    <option value="@c.IdPelanggan">@c.Nama (@c.Email)</option>
                }
            </select>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="sm:col-span-2">
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Pilih Produk Tersedia</label>
                <select name="idProduk" required class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                    <option value="">-- Pilih Produk --</option>
                    @foreach (var p in produks)
                    {
                        <option value="@p.IdProduk">@p.NamaProduk - Rp @p.Harga.ToString("N0") (Stok: @p.Stok)</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Jumlah (Qty)</label>
                <input type="number" name="jumlah" value="1" min="1" required
                       class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Kode Promo (Opsional)</label>
                <select name="idPromo" class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                    <option value="">Tanpa Promo</option>
                    @foreach (var pr in promos)
                    {
                        <option value="@pr.IdPromo">@pr.KodePromo (-Rp @pr.Diskon.ToString("N0"))</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Metode Pembayaran</label>
                <select name="metodePembayaran" class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                    <option value="Transfer Bank BCA">Transfer Bank BCA</option>
                    <option value="QRIS Instant">QRIS Instant</option>
                    <option value="Tunai / Kasir">Tunai / Kasir</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Kurir Pengiriman</label>
                <select name="metodePengiriman" class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                    <option value="JNE Reguler">JNE Reguler</option>
                    <option value="J&T Express">J&amp;T Express</option>
                    <option value="SiCepat BEST">SiCepat BEST</option>
                    <option value="Ambil di Toko">Ambil di Toko</option>
                </select>
            </div>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t border-stone-100">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-xs font-bold text-stone-700">Batal</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">Buat Transaksi</button>
        </div>
    </form>
</div>
