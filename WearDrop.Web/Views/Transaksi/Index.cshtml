@model IEnumerable<WearDrop.Web.Models.Transaksi>
@{
    ViewData["Title"] = "Transaksi & Pengiriman";
    ViewData["PageTitle"] = "Kelola Transaksi & Pengiriman";
    string? stTrans = ViewBag.StatusTransaksi as string;
    string? stBayar = ViewBag.StatusPembayaran as string;
}

<div class="space-y-6">
    <div class="bg-white p-5 rounded-2xl border border-stone-200/80 shadow-sm flex flex-wrap items-center justify-between gap-3">
        <form method="get" asp-action="Index" class="flex flex-wrap flex-1 gap-2">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Cari kode transaksi / nama pelanggan..."
                   class="flex-1 min-w-[200px] px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm focus:outline-none focus:border-slate" />

            <select name="statusTransaksi" class="px-3 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                <option value="">Semua Status Pesanan</option>
                @foreach (var s in new[] { "pending", "dikonfirmasi", "diproses", "dikirim", "selesai", "dibatalkan" })
                {
                    <option value="@s" selected="@(stTrans == s)">@s.ToUpperInvariant()</option>
                }
            </select>

            <select name="statusPembayaran" class="px-3 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                <option value="">Semua Pembayaran</option>
                <option value="menunggu_verifikasi" selected="@(stBayar == "menunggu_verifikasi")">Menunggu Verifikasi</option>
                <option value="lunas" selected="@(stBayar == "lunas")">Lunas</option>
                <option value="gagal" selected="@(stBayar == "gagal")">Gagal</option>
            </select>

            <button type="submit" class="px-4 py-2.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Filter</button>
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-stone-100 text-stone-700 text-xs font-bold">Reset</a>
        </form>

        <a asp-action="Create" class="px-4 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">+ Transaksi Baru</a>
    </div>

    <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="bg-cream/60 border-b border-stone-200/80 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                    <th class="py-3.5 px-5">Kode &amp; Tanggal</th>
                    <th class="py-3.5 px-5">Pelanggan</th>
                    <th class="py-3.5 px-5">Total</th>
                    <th class="py-3.5 px-5">Pembayaran</th>
                    <th class="py-3.5 px-5">Status Pesanan</th>
                    <th class="py-3.5 px-5 text-right">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="py-12 text-center text-stone-400">Belum ada transaksi ditemukan.</td></tr>
                }
                else
                {
                    @foreach (var t in Model)
                    {
                        <tr class="hover:bg-cream/30">
                            <td class="py-4 px-5">
                                <div class="font-bold text-espresso">@t.KodeTransaksi</div>
                                <div class="text-xs text-stone-500">@t.TanggalTransaksi.ToString("dd MMM yyyy HH:mm")</div>
                            </td>
                            <td class="py-4 px-5">
                                <div class="font-semibold">@(t.Pelanggan?.Nama ?? "-")</div>
                                <div class="text-xs text-stone-500">@t.DetailTransaksis.Sum(d => d.Jumlah) item</div>
                            </td>
                            <td class="py-4 px-5 font-bold">Rp @t.TotalPembayaran.ToString("N0")</td>
                            <td class="py-4 px-5">
                                <span class="px-2.5 py-1 rounded-md text-xs font-bold @(t.Pembayaran?.StatusPembayaran == "lunas" ? "bg-emerald-100 text-emerald-800" : t.Pembayaran?.StatusPembayaran == "gagal" ? "bg-rose-100 text-rose-700" : "bg-amber-100 text-amber-800")">
                                    @(t.Pembayaran?.StatusPembayaran ?? "belum_ada")
                                </span>
                            </td>
                            <td class="py-4 px-5">
                                <span class="px-2.5 py-1 rounded-md text-xs font-bold uppercase bg-stone-100 text-stone-700">@t.StatusTransaksi</span>
                            </td>
                            <td class="py-4 px-5 text-right">
                                <div class="inline-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@t.IdTransaksi"
                                       class="px-3 py-1.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Kelola</a>
                                    <a asp-action="Struk" asp-route-id="@t.IdTransaksi" target="_blank"
                                       class="px-3 py-1.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-espresso text-xs font-bold">Struk</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
