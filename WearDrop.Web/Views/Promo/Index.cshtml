@model IEnumerable<WearDrop.Web.Models.Promo>
@{
    ViewData["Title"] = "Kelola Promo";
    ViewData["PageTitle"] = "Kelola Kode Promo";
}

<div class="space-y-6">
    <div class="bg-white p-5 rounded-2xl border border-stone-200/80 shadow-sm flex flex-wrap items-center justify-between gap-3">
        <form method="get" asp-action="Index" class="flex flex-1 min-w-[240px] gap-2">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Cari kode atau deskripsi promo..."
                   class="flex-1 px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm focus:outline-none focus:border-slate" />
            <button type="submit" class="px-4 py-2.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Cari</button>
        </form>
        <a asp-action="Create" class="px-4 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">+ Buat Promo</a>
    </div>

    <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="bg-cream/60 border-b border-stone-200/80 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                    <th class="py-3.5 px-5">Kode Promo</th>
                    <th class="py-3.5 px-5">Potongan</th>
                    <th class="py-3.5 px-5">Periode Berlaku</th>
                    <th class="py-3.5 px-5">Status</th>
                    <th class="py-3.5 px-5">Dipakai</th>
                    <th class="py-3.5 px-5 text-right">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="py-12 text-center text-stone-400">Belum ada kode promo.</td></tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-cream/30">
                            <td class="py-4 px-5">
                                <span class="font-mono font-extrabold text-espresso bg-cream px-2.5 py-1 rounded-lg border border-stone-200">@item.KodePromo</span>
                                @if (!string.IsNullOrWhiteSpace(item.Deskripsi))
                                {
                                    <div class="text-xs text-stone-500 mt-1">@item.Deskripsi</div>
                                }
                            </td>
                            <td class="py-4 px-5 font-bold">Rp @item.Diskon.ToString("N0")</td>
                            <td class="py-4 px-5 text-xs text-stone-600">
                                @item.TanggalMulai.ToString("dd MMM yyyy") &ndash; @item.TanggalSelesai.ToString("dd MMM yyyy")
                            </td>
                            <td class="py-4 px-5">
                                <span class="px-2.5 py-1 rounded-md text-xs font-bold @(item.IsAktif ? "bg-emerald-100 text-emerald-800" : "bg-stone-100 text-stone-600")">
                                    @(item.IsAktif ? "Aktif" : "Nonaktif / Berakhir")
                                </span>
                            </td>
                            <td class="py-4 px-5">@item.Transaksis.Count kali</td>
                            <td class="py-4 px-5 text-right">
                                <div class="inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.IdPromo"
                                       class="px-3 py-1.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@item.IdPromo" method="post"
                                          onsubmit="return confirm('Hapus kode promo ini?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
