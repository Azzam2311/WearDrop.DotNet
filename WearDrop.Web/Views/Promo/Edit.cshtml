@model WearDrop.Web.Models.Promo
@{
    ViewData["Title"] = "Edit Promo";
    ViewData["PageTitle"] = $"Edit Promo {Model.KodePromo}";
}

<div class="max-w-xl bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm">
    <form asp-action="Edit" asp-route-id="@Model.IdPromo" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="KodePromo" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <input asp-for="KodePromo"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm uppercase font-mono" />
            <span asp-validation-for="KodePromo"></span>
        </div>

        <div>
            <label asp-for="Diskon" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <input asp-for="Diskon" type="number" step="1" min="0"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
            <span asp-validation-for="Diskon"></span>
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label asp-for="TanggalMulai" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
                <input asp-for="TanggalMulai" type="date"
                       class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
                <span asp-validation-for="TanggalMulai"></span>
            </div>
            <div>
                <label asp-for="TanggalSelesai" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
                <input asp-for="TanggalSelesai" type="date"
                       class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
                <span asp-validation-for="TanggalSelesai"></span>
            </div>
        </div>

        <div>
            <label asp-for="Deskripsi" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <textarea asp-for="Deskripsi" rows="2"
                      class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t border-stone-100">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-xs font-bold text-stone-700">Batal</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">Perbarui Promo</button>
        </div>
    </form>
</div>
