@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    string NavClass(string ctrl) =>
        string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase)
            ? "bg-slate text-white shadow-md shadow-slate/30"
            : "text-slate-200 hover:bg-espresso-soft hover:text-white";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WearDrop .NET CRUD</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cream: '#FAF8F3',
                        espresso: '#231F1E',
                        'espresso-soft': '#2E2928',
                        slate: {
                            DEFAULT: '#4A6B88',
                            50: '#F2F5F8',
                            100: '#E4EAF0',
                            200: '#C7D4E0',
                            300: '#9FB5C9',
                            400: '#7394B1',
                            500: '#4A6B88',
                            600: '#3A556D',
                        }
                    },
                    fontFamily: {
                        sans: ['"Open Sans"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Open Sans', sans-serif; background-color: #FAF8F3; color: #231F1E; }
        .field-validation-error { color: #dc2626; font-size: 0.75rem; font-weight: 600; margin-top: 0.25rem; display: block; }
    </style>
</head>
<body class="min-h-screen flex antialiased bg-cream text-espresso">

    <!-- Sidebar -->
    <aside class="w-72 bg-espresso text-white flex flex-col shrink-0 shadow-xl border-r border-espresso-soft min-h-screen">
        <div class="h-20 flex items-center px-6 border-b border-espresso-soft">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-slate flex items-center justify-center text-white font-extrabold text-lg shadow-md">
                    W
                </div>
                <div>
                    <span class="text-xl font-extrabold tracking-wider text-white">WEARDROP</span>
                    <div class="flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span class="text-[11px] font-semibold uppercase tracking-widest text-slate-300">.NET 10 CRUD Suite</span>
                    </div>
                </div>
            </a>
        </div>

        <nav class="flex-1 overflow-y-auto px-4 py-6 space-y-6">
            <div>
                <p class="px-3 text-[11px] font-bold uppercase tracking-widest text-slate-300/70 mb-2">Utama</p>
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Home")">
                    <span>Dashboard</span>
                </a>
            </div>

            <div>
                <p class="px-3 text-[11px] font-bold uppercase tracking-widest text-slate-300/70 mb-2">Katalog &amp; Stok</p>
                <div class="space-y-1">
                    <a asp-controller="Kategori" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Kategori")">
                        <span>Kelola Kategori</span>
                    </a>
                    <a asp-controller="Produk" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Produk")">
                        <span>Produk &amp; Stok</span>
                    </a>
                </div>
            </div>

            <div>
                <p class="px-3 text-[11px] font-bold uppercase tracking-widest text-slate-300/70 mb-2">Marketing</p>
                <a asp-controller="Promo" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Promo")">
                    <span>Kelola Promo</span>
                </a>
            </div>

            <div>
                <p class="px-3 text-[11px] font-bold uppercase tracking-widest text-slate-300/70 mb-2">Pesanan</p>
                <a asp-controller="Transaksi" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Transaksi")">
                    <span>Transaksi &amp; Pengiriman</span>
                </a>
            </div>

            <div>
                <p class="px-3 text-[11px] font-bold uppercase tracking-widest text-slate-300/70 mb-2">Pelanggan</p>
                <div class="space-y-1">
                    <a asp-controller="Pelanggan" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Pelanggan")">
                        <span>Data Pelanggan</span>
                    </a>
                    <a asp-controller="Keranjang" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Keranjang")">
                        <span>Cek Keranjang</span>
                    </a>
                </div>
            </div>

            <div>
                <p class="px-3 text-[11px] font-bold uppercase tracking-widest text-slate-300/70 mb-2">Pengaturan &amp; Akses</p>
                <a asp-controller="Pengguna" asp-action="Index" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all @NavClass("Pengguna")">
                    <span>Kelola Pengguna / Staf</span>
                </a>
            </div>
        </nav>

        <div class="p-4 border-t border-espresso-soft bg-espresso-soft/50 text-xs text-slate-300">
            <div class="font-bold text-white">ASP.NET Core MVC (.NET 10)</div>
            <div class="text-[11px] text-slate-300 mt-0.5">MySQL Database: <code class="text-emerald-300">weardrop</code></div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen">
        <header class="h-20 bg-white border-b border-stone-200/80 px-8 flex items-center justify-between sticky top-0 z-20 shadow-sm">
            <div>
                <h1 class="text-xl font-bold text-espresso">@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Dashboard")</h1>
                <p class="text-xs text-stone-500">WearDrop Management System &bull; Visual Studio Community (.NET 10 MVC)</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="px-3 py-1.5 rounded-full bg-cream border border-stone-200 text-xs font-semibold text-stone-600">
                    @DateTime.Now.ToString("dd MMM yyyy")
                </span>
                <span class="px-3 py-1 rounded-md text-xs font-bold bg-slate/10 text-slate">
                    C# / EF CORE
                </span>
            </div>
        </header>

        <div class="px-8 pt-6">
            @if (TempData["Success"] is string successMsg)
            {
                <div class="mb-4 bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-r-xl text-sm text-emerald-900 shadow-sm">
                    <strong class="font-bold">Berhasil:</strong> @successMsg
                </div>
            }
            @if (TempData["Error"] is string errorMsg)
            {
                <div class="mb-4 bg-rose-50 border-l-4 border-rose-500 p-4 rounded-r-xl text-sm text-rose-900 shadow-sm">
                    <strong class="font-bold">Perhatian:</strong> @errorMsg
                </div>
            }
        </div>

        <main class="flex-1 px-8 py-4">
            @RenderBody()
        </main>

        <footer class="py-4 px-8 border-t border-stone-200 bg-white/70 text-xs text-stone-500 flex items-center justify-between">
            <span>&copy; @DateTime.Now.Year <strong class="text-espresso">WearDrop</strong> &bull; Modul CRUD Terpisah (.NET)</span>
            <span>ASP.NET Core MVC 10.0 &bull; Entity Framework Core MySQL</span>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
