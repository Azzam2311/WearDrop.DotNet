@model IEnumerable<WearDrop.Web.Models.Pelanggan>
@{
    ViewData["Title"] = "Data Pelanggan";
    ViewData["PageTitle"] = "Kelola Data Pelanggan";
}

<div class="space-y-6">
    <div class="bg-white p-5 rounded-2xl border border-stone-200/80 shadow-sm flex flex-wrap items-center justify-between gap-3">
        <form method="get" asp-action="Index" class="flex flex-1 min-w-[240px] gap-2">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Cari nama, email, atau no. HP..."
                   class="flex-1 px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm focus:outline-none focus:border-slate" />
            <button type="submit" class="px-4 py-2.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Cari</button>
        </form>
        <a asp-action="Create" class="px-4 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">+ Tambah Pelanggan</a>
    </div>

    <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="bg-cream/60 border-b border-stone-200/80 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                    <th class="py-3.5 px-5">Nama Pelanggan</th>
                    <th class="py-3.5 px-5">Email &amp; No. HP</th>
                    <th class="py-3.5 px-5">Alamat</th>
                    <th class="py-3.5 px-5">Pesanan</th>
                    <th class="py-3.5 px-5 text-right">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="py-12 text-center text-stone-400">Belum ada data pelanggan.</td></tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr class="hover:bg-cream/30">
                            <td class="py-4 px-5 font-bold text-espresso">@p.Nama</td>
                            <td class="py-4 px-5">
                                <div>@p.Email</div>
                                <div class="text-xs text-stone-500">@p.NoHp</div>
                            </td>
                            <td class="py-4 px-5 text-xs text-stone-600 max-w-xs truncate">@(p.Alamat ?? "-")</td>
                            <td class="py-4 px-5 font-semibold">@p.Transaksis.Count transaksi</td>
                            <td class="py-4 px-5 text-right">
                                <div class="inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@p.IdPelanggan"
                                       class="px-3 py-1.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@p.IdPelanggan" method="post"
                                          onsubmit="return confirm('Hapus pelanggan ini?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
