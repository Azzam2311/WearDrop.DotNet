@model WearDrop.Web.Models.Pelanggan
@{
    ViewData["Title"] = "Tambah Pelanggan";
    ViewData["PageTitle"] = "Tambah Data Pelanggan";
}

<div class="max-w-xl bg-white p-6 rounded-2xl border border-stone-200/80 shadow-sm">
    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Nama" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <input asp-for="Nama" placeholder="Nama lengkap pelanggan"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
            <span asp-validation-for="Nama"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label asp-for="Email" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
                <input asp-for="Email" type="email" placeholder="pelanggan@email.com"
                       class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
                <span asp-validation-for="Email"></span>
            </div>
            <div>
                <label asp-for="NoHp" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
                <input asp-for="NoHp" placeholder="081234567890"
                       class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
                <span asp-validation-for="NoHp"></span>
            </div>
        </div>

        <div>
            <label class="block text-xs font-bold uppercase text-stone-600 mb-1.5">Password Akun</label>
            <input type="password" name="plainPassword" required minlength="6" placeholder="Minimal 6 karakter"
                   class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm" />
            @Html.ValidationMessage("plainPassword", null, new { @class = "field-validation-error" })
        </div>

        <div>
            <label asp-for="Alamat" class="block text-xs font-bold uppercase text-stone-600 mb-1.5"></label>
            <textarea asp-for="Alamat" rows="3" placeholder="Alamat lengkap pengiriman..."
                      class="w-full px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t border-stone-100">
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-xs font-bold text-stone-700">Batal</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">Simpan Pelanggan</button>
        </div>
    </form>
</div>
