@model IEnumerable<WearDrop.Web.Models.Produk>
@{
    ViewData["Title"] = "Produk & Stok";
    ViewData["PageTitle"] = "Kelola Produk & Stok";
    var kategoris = ViewBag.Kategoris as List<WearDrop.Web.Models.Kategori> ?? new();
    ulong? selectedKategori = ViewBag.SelectedKategori as ulong?;
    string? filterStok = ViewBag.FilterStok as string;
}

<div class="space-y-6">
    <div class="bg-white p-5 rounded-2xl border border-stone-200/80 shadow-sm flex flex-wrap items-center justify-between gap-3">
        <form method="get" asp-action="Index" class="flex flex-wrap flex-1 gap-2">
            <input type="text" name="search" value="@ViewBag.Search" placeholder="Cari nama / deskripsi produk..."
                   class="flex-1 min-w-[200px] px-4 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm focus:outline-none focus:border-slate" />

            <select name="kategori" class="px-3 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                <option value="">Semua Kategori</option>
                @foreach (var k in kategoris)
                {
                    <option value="@k.IdKategori" selected="@(selectedKategori == k.IdKategori)">@k.NamaKategori</option>
                }
            </select>

            <select name="filterStok" class="px-3 py-2.5 rounded-xl border border-stone-200 bg-cream/40 text-sm">
                <option value="">Semua Stok</option>
                <option value="kritis" selected="@(filterStok == "kritis")">Stok Kritis (&le; 5)</option>
                <option value="habis" selected="@(filterStok == "habis")">Stok Habis (0)</option>
            </select>

            <button type="submit" class="px-4 py-2.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Filter</button>
            <a asp-action="Index" class="px-4 py-2.5 rounded-xl bg-stone-100 text-stone-700 text-xs font-bold">Reset</a>
        </form>

        <a asp-action="Create" class="px-4 py-2.5 rounded-xl bg-espresso hover:bg-espresso-soft text-white text-xs font-bold">+ Produk Baru</a>
    </div>

    <div class="bg-white rounded-2xl border border-stone-200/80 shadow-sm overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead>
                <tr class="bg-cream/60 border-b border-stone-200/80 text-xs font-semibold text-stone-500 uppercase tracking-wider">
                    <th class="py-3.5 px-5">Produk</th>
                    <th class="py-3.5 px-5">Kategori</th>
                    <th class="py-3.5 px-5">Harga</th>
                    <th class="py-3.5 px-5">Update Cepat Stok</th>
                    <th class="py-3.5 px-5 text-right">Aksi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="py-12 text-center text-stone-400">Tidak ada produk yang cocok.</td></tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr class="hover:bg-cream/30">
                            <td class="py-4 px-5">
                                <div class="font-bold text-espresso">@p.NamaProduk</div>
                                @if (!string.IsNullOrWhiteSpace(p.Deskripsi))
                                {
                                    <div class="text-xs text-stone-500 truncate max-w-md">@p.Deskripsi</div>
                                }
                            </td>
                            <td class="py-4 px-5">
                                <span class="px-2.5 py-1 rounded-md bg-cream border border-stone-200 text-xs font-semibold">
                                    @(p.Kategori?.NamaKategori ?? "-")
                                </span>
                            </td>
                            <td class="py-4 px-5 font-bold">Rp @p.Harga.ToString("N0")</td>
                            <td class="py-4 px-5">
                                <form asp-action="UpdateStok" asp-route-id="@p.IdProduk" method="post" class="inline-flex items-center gap-1.5">
                                    @Html.AntiForgeryToken()
                                    <input type="number" name="stok" value="@p.Stok" min="0"
                                           class="w-20 px-2.5 py-1.5 rounded-lg border border-stone-200 text-xs font-bold @(p.Stok <= 0 ? "bg-rose-50 text-rose-700 border-rose-300" : p.Stok <= 5 ? "bg-amber-50 text-amber-800 border-amber-300" : "bg-white")" />
                                    <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-stone-100 hover:bg-stone-200 text-xs font-bold">Simpan</button>
                                </form>
                            </td>
                            <td class="py-4 px-5 text-right">
                                <div class="inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@p.IdProduk"
                                       class="px-3 py-1.5 rounded-xl bg-slate hover:bg-slate-600 text-white text-xs font-bold">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@p.IdProduk" method="post"
                                          onsubmit="return confirm('Hapus produk ini?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-3 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
